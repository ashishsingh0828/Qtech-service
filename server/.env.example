NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/servicedesk

# Required. 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Browser origin(s) allowed to call the API (comma separated).
# In dev the Vite server runs on 5173 and proxies /api to this server.
CLIENT_ORIGIN=http://localhost:5173

UPLOAD_DIR=./uploads
TZ_NAME=Asia/Kolkata

# Set to the built client folder to serve the UI from this server (single origin):
# STATIC_DIR=../client/dist

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_MAX_PER_HOUR=5
# Dev only: return the code in the API response so you can test without email.
# The server refuses to start in production with this on.
OTP_DEV_ECHO=true

# console = print the OTP in the server log (dev only), smtp = email the customer
NOTIFY_PROVIDER=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Qtech Service Desk <no-reply@example.com>"

# Behind a reverse proxy (nginx, Render, etc.) set the number of proxy hops, usually 1
# TRUST_PROXY=1

BCRYPT_ROUNDS=12
LOGIN_RATE_MAX=10

# For `npm run seed:admin`
# SEED_ADMIN_NAME=Admin User
# SEED_ADMIN_EMAIL=admin@yourcompany.com
# SEED_ADMIN_PASSWORD=
