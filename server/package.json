{
  "name": "qtech-service-desk-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed:admin": "node src/seed.js admin",
    "seed:demo": "node src/seed.js demo",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:int": "node --test --test-concurrency=1 \"test/integration/api.test.js\" && node --test --test-concurrency=1 \"test/integration/storage.test.js\"",
    "test:mail": "node scripts/test-mail.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "multer": "^2.0.0",
    "nodemailer": "^7.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0"
  }
}
